{
  "productName": "Time Planner",
  "version": "1.1.1",
  "identifier": "com.timeplanner.app",
  "build": {
    "beforeDevCommand": "node build-minify.js",
    "beforeBuildCommand": "node build-minify.js",
    "frontendDist": "../src-dist"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "publisher": "Michał Kania",
    "copyright": "© 2025 Michał Kania",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "allowDowngrades": false
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Time Planner",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "skipTaskbar": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' asset: https://asset.localhost"
    }
  }
}
